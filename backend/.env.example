# Idea Bubbles Backend Configuration

# Application
APP_NAME="Idea Bubbles API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
# Generate a secure secret key: openssl rand -hex 32
SECRET_KEY="supersecret_change_me_in_production_idea_bubbles_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite for zero-setup local dev. For PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/idea_bubbles"
DATABASE_URL="sqlite:///./idea_bubbles.db"

# AI Configuration (Optional: application gracefully falls back to offline heuristics if omitted)
# Supported: gemini, openai
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
